# --------------------------------------------------------------------------
# EdGrant deployment configuration
# Copy to .env and fill in. NEVER commit .env (it is gitignored).
#
# READ KEYS.md BEFORE PUTTING ANY KEY IN THIS FILE.
# Short version: raw keys in env vars leak through shell history, `ps -e`, and
# stray .env copies. That is tolerable for throwaway testnet keys holding
# nothing but faucet tBOT. It is not tolerable for anything else.
# --------------------------------------------------------------------------

# ---- Deployer -------------------------------------------------------------
# PREFERRED: do not set PRIVATE_KEY at all. Import once into Foundry's
# encrypted keystore and pass --account instead:
#   cast wallet import edgrant-deployer --interactive
#   forge script script/Deploy.s.sol:Deploy --rpc-url bohr --broadcast \
#     --account edgrant-deployer
# Only set this if you are using a disposable testnet key.
PRIVATE_KEY=

# ---- Verifier set ---------------------------------------------------------
# ADDRESSES ONLY. Never put verifier private keys in this file.
# At least 2; the deploy script refuses a single-verifier registry because one
# verifier could unilaterally grant or revoke institutional identity.
#
# These are the highest-value keys in the system. They decide which wallets are
# recognised as real schools. Treat them as production key material even on
# testnet, so the habit is right by the time it matters. See KEYS.md.
VERIFIERS=0x...,0x...,0x...
VERIFIER_THRESHOLD=2

# ---- Registry parameters --------------------------------------------------
# Anti-spam deposit for a verification application, in wei of native BOT.
# Sized to deter low-effort impersonation, not to raise revenue.
VERIFICATION_FEE_WEI=500000000000000000

# Only needed for local/anvil deploys. On chain 968 and 677 the deploy script
# uses the known USDT address and ignores this.
TOKEN_ADDRESS=

# --------------------------------------------------------------------------
# SeedDemo only - THROWAWAY KEYS ONLY, testnet and local.
#
# SeedDemo needs several signers in one run, which --account cannot express, so
# it reads raw keys. Generate fresh ones with `cast wallet new` and never reuse
# them for anything. SeedDemo hard-refuses chain 677, so this pattern is
# structurally confined to local and testnet.
# --------------------------------------------------------------------------
VERIFIER_A_PK=
VERIFIER_B_PK=
SCHOOL_PK=
DONOR_PK=

# Set these when seeding against already-deployed testnet contracts.
REGISTRY_ADDRESS=
VAULT_ADDRESS=
PROFILE_ADDRESS=
LENS_ADDRESS=
