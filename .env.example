# --------------------------------------------------------------------------
# EdGrant deployment configuration
# Copy to .env and fill in. NEVER commit .env.
# --------------------------------------------------------------------------

# Deployer. Prefer a hardware wallet or `cast wallet` keystore over a raw key:
#   forge script ... --account edgrant-deployer
PRIVATE_KEY=

# The verifier multisig set. At least 2 addresses, comma separated.
# The deploy script refuses to ship a single-verifier registry, because a single
# verifier could unilaterally grant or revoke institutional identity.
VERIFIERS=0x...,0x...,0x...
VERIFIER_THRESHOLD=2

# Anti-spam deposit for a verification application, in wei of native BOT.
# Sized to deter low-effort impersonation, not to raise revenue.
VERIFICATION_FEE_WEI=500000000000000000

# Only needed for local/anvil deploys. On chain 968 and 677 the script uses the
# known USDT address and ignores this.
TOKEN_ADDRESS=
